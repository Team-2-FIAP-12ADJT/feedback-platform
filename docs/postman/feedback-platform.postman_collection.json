          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Explicacao de Lambda ficou confusa e o exemplo nao rodou. Validacao manual T-10 CRITICAL.\",\n  \"nota\": 2\n}"
            },
            "url": "{{baseUrl}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('sem Location', () => pm.expect(pm.response.headers.get('Location')).to.be.undefined);",
                  "const b = pm.response.json();",
                  "pm.test('id e dataEnvio', () => { pm.expect(b.id).to.be.a('string'); pm.expect(b.dataEnvio).to.be.a('string'); });",
                  "pm.test('sem urgency', () => pm.expect(b).to.not.have.property('urgency'));",
                  "pm.collectionVariables.set('lastCriticalId', b.id);",
                  "pm.collectionVariables.set('lastCriticalDataEnvio', b.dataEnvio);"
                ]
              }
            }
          ]
        }
      ]
